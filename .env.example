# ==========================
# PROJECT
# ==========================

PROJECT_NAME=AI-jobhunter

PROJECT_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=True

# ==========================
# API
# ==========================

API_V1_PREFIX=/api/v1

